# PyInstaller (движок в resources/engine/)
resources/engine/build/
resources/engine/dist/
resources/engine/*.spec
resources/engine/__pycache__/
**/__pycache__/
*.pyc
# NanoDecompilerCLI.exe встраивается ПРЯМО в resources/engine/ при сборке
# клиента (см. .github/workflows/build-and-release.yml::build-client) -
# генерируется в CI, никогда не коммитится.
resources/engine/NanoDecompilerCLI.exe
resources/engine/.engine-api-version
release-files/versions.json

# Внутренние хэндофф-заметки между сессиями работы над проектом - рабочий
# дневник, не предназначен для публичного репозитория.
resources/engine/HANDOFF*.md

# CI-мусор, который иногда остаётся после локального прогона проверок
out_check_cli/
out_check_api/
out_check_client_cli/

